{
  "name": "soon2026-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint"
  },
  "trustedDependencies": [
    "react-native-executorch"
  ],
  "react-native-executorch": {
    "features": [
      "objectDetection"
    ]
  }
}
